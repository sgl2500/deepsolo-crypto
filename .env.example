# Copy this file to .env.local and adjust local-only paths.
# Shell-exported variables always win over values in .env/.env.local.

APP_TIMEZONE=Asia/Shanghai

# Local project data. These directories are ignored by Git.
DATA_ROOT=./data/normalized_gzip
CRYPTO_DATA_ROOT=./data/normalized_gzip
CATALOG_ROOT=./data/catalog

# Runtime files are local state: sqlite DBs, generated indicators, logs, task status.
RUNTIME_ROOT=./.runtime
BACKTEST_DB=./.runtime/backtests.sqlite3
SCREENER_FAVORITES_DB=./.runtime/screener_favorites.sqlite3
INDICATOR_STORE_PATH=./.runtime/indicator_repository.json
SCRIPT_INDICATOR_ROOT=./.runtime/script_indicators
CONTRACT_UPDATE_RUNTIME_DIR=./.runtime/contract_update

# Local data update pipeline copied into this project.
USE_LEGACY_PIPELINE=true
CRYPTO_V2_ROOT=./local-pipeline/crypto-v2
STRATEGY_RESEARCH_ROOT=./local-pipeline/strategy-research
OKX_RELAY_BASE_URL=http://154.21.91.216:8000

# Script indicator generation. Put OPENAI_API_KEY in .env.local or .runtime/secrets.env.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com
